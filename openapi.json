{
  "openapi": "3.1.0",
  "info": {
    "title": "Tianxing Ren profile and projects for agents",
    "version": "3.0.0",
    "description": "Direct access to the complete researcher profile and projects. Served by server.py or the included Cloudflare Worker; static data/*.json files work on static hosts."
  },
  "servers": [
    {
      "url": "https://tianxing-ren.netlify.app"
    }
  ],
  "paths": {
    "/api/agents": {
      "get": {
        "operationId": "getAgentProfile",
        "summary": "Read the complete profile, research goals, projects, internships, visits, and source links",
        "responses": {
          "200": {
            "description": "Complete agent profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentProfile"
                }
              }
            }
          }
        }
      }
    },
    "/api/profile": {
      "get": {
        "operationId": "getProfile",
        "summary": "Read identity, education, experience, awards, and public contact-page URL",
        "responses": {
          "200": {
            "description": "Public profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects": {
      "get": {
        "operationId": "listProjects",
        "summary": "List leading projects and participating projects separately",
        "responses": {
          "200": {
            "description": "Project directory",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectDirectory"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{id}": {
      "get": {
        "operationId": "getProject",
        "summary": "Read project stage, source availability, highlights, and evaluation scope",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "tilelang-tpu",
                "tilelang-riscv"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectRecord"
                }
              }
            }
          },
          "404": {
            "description": "Unknown project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/agent": {
      "get": {
        "operationId": "discoverAgentTools",
        "summary": "Discover public AI assistant tools and MCP access",
        "responses": {
          "200": {
            "description": "Agent tool definitions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/query": {
      "post": {
        "operationId": "findRelevantWork",
        "summary": "Find documented work relevant to a topic, with sources and evaluation scope",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "topic": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "language": {
                    "type": "string",
                    "enum": [
                      "en",
                      "zh",
                      "ko",
                      "ms"
                    ]
                  }
                },
                "required": [
                  "topic"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Relevant projects and profile",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid topic",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "429": {
            "description": "Please retry later",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp": {
      "post": {
        "operationId": "callProfileMCP",
        "summary": "MCP tools for profile, projects and relevant work",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "jsonrpc",
                  "method"
                ],
                "properties": {
                  "jsonrpc": {
                    "const": "2.0"
                  },
                  "id": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "method": {
                    "type": "string"
                  },
                  "params": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid MCP request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "429": {
            "description": "Please retry later",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProjectRecord": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "role",
          "stage",
          "open_source",
          "summary",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "const": "leading-project"
          },
          "role": {
            "const": "project-lead"
          },
          "stage": {
            "type": "string",
            "enum": [
              "milestone-complete",
              "in-progress"
            ]
          },
          "open_source": {
            "type": "boolean"
          },
          "summary": {
            "type": "string"
          },
          "overview": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri-reference"
          },
          "markdown": {
            "type": "string",
            "format": "uri-reference"
          },
          "repository": {
            "type": "string",
            "format": "uri"
          },
          "evaluation": {
            "type": "object",
            "description": "Hardware, baseline, metric definition, result values, configuration counts, and scope must be cited together.",
            "properties": {
              "hardware": {
                "type": "string"
              },
              "baseline": {
                "type": "string"
              },
              "metric": {
                "type": "string"
              },
              "average_speedup": {
                "type": "number"
              },
              "faster_configurations": {
                "type": "integer"
              },
              "total_configurations": {
                "type": "integer"
              },
              "scope": {
                "type": "string"
              },
              "methods": {
                "type": "string"
              }
            }
          }
        }
      },
      "Profile": {
        "type": "object",
        "required": [
          "name",
          "education",
          "experience",
          "awards",
          "contact"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "name_native": {
            "type": "string"
          },
          "education": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "experience": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "awards": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "contact": {
            "type": "object",
            "description": "Contact-page URL and public GitHub profiles. No email address.",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri-reference"
              },
              "interaction": {
                "const": "human-initiated"
              }
            }
          }
        }
      },
      "ProjectDirectory": {
        "type": "object",
        "required": [
          "leading_projects",
          "participation"
        ],
        "properties": {
          "leading_projects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectRecord"
            }
          },
          "participation": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "url",
                "role"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "role": {
                  "const": "contributor"
                }
              }
            }
          }
        }
      },
      "AgentProfile": {
        "type": "object",
        "required": [
          "profile",
          "leading_projects",
          "participation",
          "content_markdown",
          "url"
        ],
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/Profile"
          },
          "leading_projects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectRecord"
            }
          },
          "participation": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "content_markdown": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri-reference"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
