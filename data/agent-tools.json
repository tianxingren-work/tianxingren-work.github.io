{
  "name": "Tianxing Ren public research tools",
  "mcp": "https://tianxing-ren.netlify.app/api/mcp",
  "query": "https://tianxing-ren.netlify.app/api/agent/query",
  "protocol_versions": [
    "2026-07-28",
    "2025-11-25"
  ],
  "tools": [
    {
      "name": "get_profile",
      "description": "Read Tianxing Ren’s AI compiler research goals, education, advisors, internships and visits.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "en",
              "zh",
              "ko",
              "ms"
            ]
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "get_projects",
      "description": "Read projects Tianxing Ren leads or contributes to, with roles, source links and evaluation scope.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "en",
              "zh",
              "ko",
              "ms"
            ]
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "find_relevant_work",
      "description": "Find relevant AI compiler work from a short topic. Returns project matches, source links and evaluation limits.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "zh",
              "ko",
              "ms"
            ]
          }
        },
        "required": [
          "topic"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "get_contact",
      "description": "Read Tianxing Ren’s public contact channels, including readable email text, contact-page URL and GitHub profiles.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "en",
              "zh",
              "ko",
              "ms"
            ]
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    }
  ]
}
